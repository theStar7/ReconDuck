[Desktop Entry]
Version=1.0
Name=ReconDuck
Comment=A stand-alone graphics API debugger
Comment[ru]=Автономный отладчик графических API
GenericName=Graphics Debugger
Exec=qreconduck %f
Icon=application-x-reconduck-capture
Terminal=false
Type=Application
X-MultipleArgs=false
Categories=Development;
Keywords=ReconDuck;
Keywords[ru]=РендерДок;
StartupNotify=true
MimeType=application/x-reconduck-capture;
